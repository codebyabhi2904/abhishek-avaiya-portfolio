# Copy this file to .env.local and fill in real values.

# Contact form submission service. Set to the Web3Forms submit endpoint to
# use Web3Forms (https://web3forms.com); any other JSON-accepting POST
# endpoint also works. Leave unset and the form shows an honest
# "not connected yet" state instead of a fake success message.
VITE_CONTACT_FORM_ENDPOINT=https://api.web3forms.com/submit

# Required when VITE_CONTACT_FORM_ENDPOINT points at Web3Forms — get this
# from your Web3Forms dashboard (https://web3forms.com/).
VITE_WEB3FORMS_ACCESS_KEY=

# Google tag (GA4 + Google Tag Manager share this gtag.js loader). Set to a
# GA4 Measurement ID (G-XXXXXXXXXX) and/or a GTM container ID (GTM-XXXXXXX)
# to enable tracking. Both are optional and independent.
VITE_GA4_MEASUREMENT_ID=
VITE_GTM_CONTAINER_ID=
